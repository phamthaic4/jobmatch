# Copy to .env and fill in. Never commit .env.

# Google Gemini API key (used by POST /interview-prep — added in Week 7)
GOOGLE_API_KEY=

# Model settings
# onnx        -> ONNX Runtime, ~12 ms per short sentence on CPU (default)
# transformers -> plain PyTorch, ~30 ms
JOBMATCH_MODEL_BACKEND=onnx

# Where the checkpoint lives. Leave unset to use ./models/phobert-ner
# JOBMATCH_MODEL_DIR=./models/phobert-ner

# Set to 0 when the weights are baked into the image (production)
JOBMATCH_ALLOW_DOWNLOAD=1

# Max characters accepted by /extract-skills
JOBMATCH_MAX_TEXT_LENGTH=8000
